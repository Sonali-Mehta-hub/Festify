<%- layout("/layouts/boilerplate") %>

<div class="container-fluid container">

<div class="row">
    <div class="col-8 offset-2  mt-5">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <h1 class="text-center mb-4 text-purple  new-create"><b>SignUp</h1>

            <div class="row mb-3 offset-3 " >
                <div class="col-md-8">
                    <label for="title" class="form-label text-purple">Username</label>
                    <input type="text" name="username" placeholder="username" class="form-control mb-2" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">username should be valid</div>

                </div>

                <div class="col-md-8">
                    <label for="title" class="form-label text-purple">Email</label>
                    <input type="email" name="email" placeholder="email" class="form-control mb-2" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">email should be valid</div>

                </div>

                <div class="col-md-8">
                    <label for="title" class="form-label text-purple">Password</label>
                    <input type="password" name="password" placeholder="password" class="form-control mb-2" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">password should be valid</div>

                </div>
            </div>

            <div class="text-center">
               <button class="btn btn-success add-btn px-4">Submit</button>
               <br><br>
               <a href="/auth/google" class="google-btn">
                  <span class="google-icon">
                    <svg viewBox="0 0 46 46" xmlns="http://www.w3.org/2000/svg">
                      <path d="M23 9.5c3.1 0 5.8 1.1 7.9 2.9l5.9-5.9C33 3.1 28.3 1 23 1 14.5 1 7.1 5.6 3.4 12.6l6.8 5.3C12.9 13.1 17.6 9.5 23 9.5z" fill="#EA4335"/>
                      <path d="M42.6 23.5c0-1.5-.1-2.6-.4-3.8H23v7.2h11.4c-.5 2.8-2 5.1-4.2 6.7l6.4 5C40.6 34.1 42.6 29.6 42.6 23.5z" fill="#4285F4"/>
                      <path d="M10.2 27.9a13.8 13.8 0 0 1 0-8v-5.3L3.4 9.4A22.8 22.8 0 0 0 1 23.5c0 3.8.9 7.4 2.5 10.6l6.7-5.2z" fill="#FBBC05"/>
                      <path d="M23 44c6.1 0 11.2-2.1 14.9-5.7l-7.1-5.6c-2 1.4-4.5 2.2-7.8 2.2-5.4 0-10-3.5-11.7-8.2l-6.8 5.3C7.1 38.4 14.5 44 23 44z" fill="#34A853"/>
                      <path fill="none" d="M1 1h44v44H1z"/>
                    </svg>
                  </span>
                  Continue with Google
               </a>
               <br><br>
               <p class="ms-8">
               Already have an account?
               <a href="/login" class="text-purple fw-bold" style="text-decoration: none;">
               Login here
               </a>
              </p>
            </div>

        </form>

    </div>
</div>
</div>